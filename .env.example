# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
ENVIRONMENT=local
LOG_LEVEL=INFO
TRAFFIC_REQUESTS_PER_SECOND=5
API_PORT=8000

# --- Database ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Observability sources the agent reads from ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_PASSWORD=admin

# --- Demo service ---
DEMO_SERVICE_URL=http://localhost:8001

# --- Incident correlation ---
# Alerts for the same service + alert_type inside this window join one incident.
CORRELATION_WINDOW_SECONDS=300

# --- LLM provider (agent lands in week 3; adapter is provider-agnostic) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
PROMPT_VERSION=incident-analysis-v1

# --- Embeddings for runbook RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
